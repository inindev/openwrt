From: John Clark <inindev@gmail.com>
Subject: [PATCH] net: stmmac: dwmac-meson8b: enable TX clk in RMII mode

AXG RMII DMA software reset needs the PRG_ETH0 m250 / bit-10 clock
tree running. RGMII already clk_set_rate + prepare_enable that clock;
RMII only set INVERTED_RMII_CLK. After clk_disable_unused, and with
no U-Boot leftover, dwmac_dma_reset times out.

Signed-off-by: John Clark <inindev@gmail.com>
---

--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-meson8b.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-meson8b.c
@@ -380,6 +380,25 @@
 		meson8b_dwmac_mask_bits(dwmac, PRG_ETH0,
 					PRG_ETH0_INVERTED_RMII_CLK,
 					PRG_ETH0_INVERTED_RMII_CLK);
+
+		/* Enable the m250 / PRG_ETH0 bit-10 tree. RGMII already
+		 * does this; RMII did not. Without it, DMA SWR times out
+		 * on AXG when U-Boot leaves no leftover clock.
+		 */
+		ret = clk_set_rate(dwmac->rgmii_tx_clk, 125 * 1000 * 1000);
+		if (ret) {
+			dev_err(dwmac->dev,
+				"failed to set RMII TX clock\n");
+			return ret;
+		}
+
+		ret = meson8b_devm_clk_prepare_enable(dwmac,
+						      dwmac->rgmii_tx_clk);
+		if (ret) {
+			dev_err(dwmac->dev,
+				"failed to enable the RMII TX clock\n");
+			return ret;
+		}
 	}
 
 	/* enable TX_CLK and PHY_REF_CLK generator */
