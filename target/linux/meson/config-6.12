# Amlogic Meson AXG SoC. Applied on top of generic/config-6.12;
# axg/config-6.12 is applied after this file.

CONFIG_ARCH_MESON=y
CONFIG_CPU_LITTLE_ENDIAN=y
# CONFIG_CPU_BIG_ENDIAN is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=y
CONFIG_SCHED_MC=y
CONFIG_ARM_GIC=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
# CONFIG_COMPAT_32BIT_TIME is not set
CONFIG_FRAME_WARN=2048

CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_MESON_REGMAP=y
CONFIG_COMMON_CLK_MESON_DUALDIV=y
CONFIG_COMMON_CLK_MESON_MPLL=y
CONFIG_COMMON_CLK_MESON_PLL=y
CONFIG_COMMON_CLK_MESON_AO_CLKC=y
CONFIG_COMMON_CLK_MESON_EE_CLKC=y
CONFIG_COMMON_CLK_AXG=y

CONFIG_MAILBOX=y
# SCPI talks through amlogic,meson-gxbb-mhu, which is PLATFORM_MHU.
CONFIG_PLATFORM_MHU=y
CONFIG_ARM_SCPI_PROTOCOL=y
# The AXG scpi node has no power-domain child.
# CONFIG_ARM_SCPI_POWER_DOMAIN is not set
CONFIG_COMMON_CLK_SCPI=y
CONFIG_MESON_SM=y

CONFIG_MESON_IRQ_GPIO=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y
CONFIG_NVMEM_MESON_EFUSE=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_MESON=y

CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# Power domains need PM. ethmac sits in the AXG pwrc ETHERNET_MEM domain.
CONFIG_PM=y
CONFIG_MESON_GX_SOCINFO=y
CONFIG_MESON_EE_PM_DOMAINS=y
# Secure pwrc covers A1, A4, A5, C3, S4 and T7, not AXG.
# CONFIG_MESON_SECURE_PM_DOMAINS is not set
CONFIG_MESON_CLK_MEASURE=y

CONFIG_PINCTRL=y
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_AXG=y
CONFIG_PINCTRL_MESON_AXG_PMX=y
CONFIG_OF_GPIO=y
CONFIG_LEDS_GPIO=y

CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

CONFIG_BLK_DEV_LOOP=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

CONFIG_MMC=y
CONFIG_MMC_MESON_GX=y
CONFIG_MMC_BLOCK=y
CONFIG_PWRSEQ_EMMC=y
CONFIG_PWRSEQ_SIMPLE=y

CONFIG_EXTCON=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_MESON_G12A=y
# CONFIG_USB_DWC3_OF_SIMPLE is not set
CONFIG_PHY_MESON_GXL_USB2=y
# CONFIG_PHY_MESON8B_USB2 is not set
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_MESON=y
# CONFIG_DWMAC_GENERIC is not set
CONFIG_OF_MDIO=y
CONFIG_REALTEK_PHY=y
# STMMAC_ETH depends on PTP_1588_CLOCK_OPTIONAL. If kmod-ptp makes PTP a
# module, Kconfig silently demotes stmmac and dwmac-meson to modules.
CONFIG_PPS=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_RPS=y
CONFIG_RFS_ACCEL=y
CONFIG_NET_FLOW_LIMIT=y

CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_MESON=y
CONFIG_WATCHDOG=y
CONFIG_MESON_GXBB_WATCHDOG=y

# CPU DVFS through the SCP firmware. ARM_SCPI_CPUFREQ does not select
# PM_OPP, which it needs to load the firmware OPP table; CPUFREQ_DT does.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
# CONFIG_CPU_FREQ_GOV_USERSPACE is not set
# CONFIG_CPU_FREQ_GOV_ONDEMAND is not set
# CONFIG_CPU_FREQ_GOV_CONSERVATIVE is not set
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# Schedutil exposes this prompt. Other OpenWrt targets leave it off.
# CONFIG_UCLAMP_TASK is not set
CONFIG_ARM_SCPI_CPUFREQ=y
CONFIG_CPUFREQ_DT=y

# The SoC temperature comes from SCPI. Build the sensor in so the
# critical trip works from early boot, not after kmodloader.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=0
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_ARM_SCPI=y
# amlogic_thermal only supports G12A and A1.
# CONFIG_AMLOGIC_THERMAL is not set

# Turn off drivers for other Meson generations.
# CONFIG_MESON_GXL_PHY is not set
# CONFIG_MDIO_BUS_MUX_MESON_G12A is not set
# CONFIG_MDIO_BUS_MUX_MESON_GXL is not set
# CONFIG_PINCTRL_MESON_GXBB is not set
# CONFIG_PINCTRL_MESON_GXL is not set
# CONFIG_PINCTRL_MESON_G12A is not set
# CONFIG_PINCTRL_MESON_A1 is not set
# CONFIG_PINCTRL_MESON_S4 is not set
# CONFIG_PINCTRL_AMLOGIC_C3 is not set
# CONFIG_PINCTRL_AMLOGIC_T7 is not set
# CONFIG_MESON_WATCHDOG is not set
# CONFIG_MMC_MESON_MX_SDIO is not set
# CONFIG_RTC_DRV_MESON_VRTC is not set
# CONFIG_COMMON_CLK_GXBB is not set
# CONFIG_COMMON_CLK_AXG_AUDIO is not set
# CONFIG_COMMON_CLK_A1_PLL is not set
# CONFIG_COMMON_CLK_A1_PERIPHERALS is not set
# CONFIG_COMMON_CLK_C3_PLL is not set
# CONFIG_COMMON_CLK_C3_PERIPHERALS is not set
# CONFIG_COMMON_CLK_G12A is not set
# CONFIG_COMMON_CLK_S4_PLL is not set
# CONFIG_COMMON_CLK_S4_PERIPHERALS is not set
# CONFIG_ARM_MHU_V2 is not set
# CONFIG_ARM_MHU_V3 is not set
# CONFIG_MAILBOX_TEST is not set
# CONFIG_MESON_CANVAS is not set
# CONFIG_RESET_MESON_AUDIO_ARB is not set
# CONFIG_PHY_MESON_G12A_MIPI_DPHY_ANALOG is not set
# CONFIG_PHY_MESON_G12A_USB2 is not set
# CONFIG_PHY_MESON_G12A_USB3_PCIE is not set
# CONFIG_PHY_MESON_AXG_PCIE is not set
# CONFIG_PHY_MESON_AXG_MIPI_PCIE_ANALOG is not set
# CONFIG_PHY_MESON_AXG_MIPI_DPHY is not set
# CONFIG_NVMEM_MESON_MX_EFUSE is not set

# Prompts that ALL_KMODS exposes by enabling the SPI, MFD, and sound menus.
# AXG has no SPIFC, and the AXG audio drivers need COMMON_CLK_AXG_AUDIO.
# CONFIG_SPI_AMLOGIC_SPIFC_A1 is not set
# CONFIG_SPI_MESON_SPIFC is not set
# CONFIG_MFD_KHADAS_MCU is not set
# CONFIG_SND_MESON_AIU is not set
# CONFIG_SND_MESON_AXG_FRDDR is not set
# CONFIG_SND_MESON_AXG_TODDR is not set
# CONFIG_SND_MESON_AXG_TDMIN is not set
# CONFIG_SND_MESON_AXG_TDMOUT is not set
# CONFIG_SND_MESON_AXG_SOUND_CARD is not set
# CONFIG_SND_MESON_AXG_SPDIFOUT is not set
# CONFIG_SND_MESON_AXG_SPDIFIN is not set
# CONFIG_SND_MESON_AXG_PDM is not set
# CONFIG_SND_MESON_GX_SOUND_CARD is not set
# CONFIG_SND_MESON_G12A_TOACODEC is not set
# CONFIG_SND_MESON_G12A_TOHDMITX is not set
# CONFIG_SND_SOC_MESON_T9015 is not set
