# Amlogic Meson AXG SoC. Merged on top of generic + axg/config-6.12.

CONFIG_ARCH_MESON=y
CONFIG_CPU_LITTLE_ENDIAN=y
# CONFIG_CPU_BIG_ENDIAN is not set
CONFIG_SMP=y
CONFIG_SMP_ON_UP=y
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=y
CONFIG_SCHED_MC=y
CONFIG_ARM_GIC=y
CONFIG_ARM_PSCI_FW=y

CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_MESON_REGMAP=y
CONFIG_COMMON_CLK_MESON_DUALDIV=y
CONFIG_COMMON_CLK_MESON_MPLL=y
CONFIG_COMMON_CLK_MESON_PLL=y
CONFIG_COMMON_CLK_MESON_AO_CLKC=y
CONFIG_COMMON_CLK_MESON_EE_CLKC=y
CONFIG_COMMON_CLK_AXG=y

CONFIG_MAILBOX=y
CONFIG_ARM_MHU=y
CONFIG_ARM_SCPI_PROTOCOL=y
CONFIG_ARM_SCPI_POWER_DOMAIN=y
CONFIG_COMMON_CLK_SCPI=y
CONFIG_MESON_SM=y

CONFIG_MESON_IRQ_GPIO=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y
CONFIG_NVMEM_MESON_EFUSE=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_MESON=y

CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_MESON_GX_SOCINFO=y
CONFIG_MESON_GX_PM_DOMAINS=y
CONFIG_MESON_EE_PM_DOMAINS=y
CONFIG_MESON_SECURE_PM_DOMAINS=y
CONFIG_MESON_CLK_MEASURE=y

CONFIG_PINCTRL=y
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_AXG=y
CONFIG_PINCTRL_MESON_AXG_PMX=y
CONFIG_OF_GPIO=y
CONFIG_LEDS_GPIO=y

CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

CONFIG_BLK_DEV_LOOP=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

CONFIG_MMC=y
CONFIG_MMC_MESON_GX=y
CONFIG_MMC_BLOCK=y
CONFIG_PWRSEQ_EMMC=y
CONFIG_PWRSEQ_SIMPLE=y

CONFIG_EXTCON=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_MESON_G12A=y
# CONFIG_USB_DWC3_OF_SIMPLE is not set
CONFIG_PHY_MESON_GXL_USB2=y
# CONFIG_PHY_MESON8B_USB2 is not set
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_MESON=y
CONFIG_OF_MDIO=y
CONFIG_REALTEK_PHY=y

CONFIG_HW_RANDOM_MESON=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_AMLOGIC_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_MESON_GXBB_WATCHDOG=y

# Remaining 6.12 prompts. Pin AXG-only; turn off other Meson generations.
# CONFIG_COMPAT_32BIT_TIME is not set
CONFIG_RPS=y
CONFIG_RFS_ACCEL=y
CONFIG_NET_FLOW_LIMIT=y
# CONFIG_MESON_GXL_PHY is not set
# CONFIG_MDIO_BUS_MUX_MESON_G12A is not set
# CONFIG_MDIO_BUS_MUX_MESON_GXL is not set
# CONFIG_PINCTRL_MESON_GXBB is not set
# CONFIG_PINCTRL_MESON_GXL is not set
# CONFIG_PINCTRL_MESON_G12A is not set
# CONFIG_PINCTRL_MESON_A1 is not set
# CONFIG_PINCTRL_MESON_S4 is not set
# CONFIG_PINCTRL_AMLOGIC_C3 is not set
# CONFIG_PINCTRL_AMLOGIC_T7 is not set
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=0
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
# CONFIG_MESON_WATCHDOG is not set
# CONFIG_MMC_MESON_MX_SDIO is not set
# CONFIG_RTC_DRV_MESON_VRTC is not set
# CONFIG_COMMON_CLK_GXBB is not set
# CONFIG_COMMON_CLK_AXG_AUDIO is not set
# CONFIG_COMMON_CLK_A1_PLL is not set
# CONFIG_COMMON_CLK_A1_PERIPHERALS is not set
# CONFIG_COMMON_CLK_C3_PLL is not set
# CONFIG_COMMON_CLK_C3_PERIPHERALS is not set
# CONFIG_COMMON_CLK_G12A is not set
# CONFIG_COMMON_CLK_S4_PLL is not set
# CONFIG_COMMON_CLK_S4_PERIPHERALS is not set
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
# CONFIG_ARM_MHU_V2 is not set
# CONFIG_ARM_MHU_V3 is not set
# CONFIG_MAILBOX_TEST is not set
# CONFIG_MESON_CANVAS is not set
# CONFIG_RESET_MESON_AUDIO_ARB is not set
# CONFIG_PHY_MESON_G12A_MIPI_DPHY_ANALOG is not set
# CONFIG_PHY_MESON_G12A_USB2 is not set
# CONFIG_PHY_MESON_G12A_USB3_PCIE is not set
# CONFIG_PHY_MESON_AXG_PCIE is not set
# CONFIG_PHY_MESON_AXG_MIPI_PCIE_ANALOG is not set
# CONFIG_PHY_MESON_AXG_MIPI_DPHY is not set
# CONFIG_NVMEM_MESON_MX_EFUSE is not set
# CONFIG_DWMAC_GENERIC is not set
CONFIG_FRAME_WARN=2048
